# Copy to server/.env (never commit the real file). Only needed for live Twitch EventSub.
PORT=8787
# Twitch application Client ID (dev.twitch.tv/console)
TWITCH_CLIENT_ID=
# Broadcaster *user* access token with scopes: channel:read:subscriptions channel:read:hype_train
TWITCH_USER_TOKEN=
TWITCH_BROADCASTER_LOGIN=your_channel_name
# Hype Train EventSub version ("2" is current; set "1" only if your app still uses v1)
TWITCH_HYPE_TRAIN_VERSION=2
# Optional: require this header (x-emit-key) on POST /api/emit
EMIT_KEY=
